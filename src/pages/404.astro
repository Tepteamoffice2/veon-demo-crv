---
import Base from "../layouts/Base.astro";
import { contacts } from "../data/site";
---
<Base lang="uk" title="Сторінку не знайдено — Центр Реабілітації та Відновлення" description="Сторінку не знайдено.">
  <section class="section field not-found">
    <div class="container">
      <h1 class="h2">Сторінку не знайдено</h1>
      <p class="lead not-found__text">Можливо, адреса змінилася. Поверніться на головну або зателефонуйте нам.</p>
      <p class="not-found__actions">
        <a class="btn btn--accent" href={import.meta.env.BASE_URL}>На головну</a>
        <a class="text-link" href={contacts.phoneHref}>{contacts.phoneText}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .not-found { min-height: 70svh; display: grid; align-items: center; }
  .not-found__text { margin-top: var(--s-3); color: var(--color-ice); max-width: 40ch; }
  .not-found__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4); margin-top: var(--s-5); }
  .not-found__actions .text-link { display: inline-flex; align-items: center; min-height: var(--tap); font-size: var(--fs-lead); }
</style>
